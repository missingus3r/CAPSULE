CAPSULE_HOST=127.0.0.1
CAPSULE_PORT=8787
CAPSULE_STORAGE_DIR=./data
CAPSULE_CORS_ORIGIN=http://localhost:5173
CAPSULE_MAX_CAPSULE_BYTES=104857600
CAPSULE_MAX_CHUNK_BYTES=1048600
CAPSULE_MAX_MANIFEST_BYTES=262144
CAPSULE_MAX_CHUNK_COUNT=10000
CAPSULE_DEFAULT_TTL_SECONDS=86400
CAPSULE_MAX_TTL_SECONDS=604800
CAPSULE_CLEANUP_INTERVAL_MS=60000
CAPSULE_RATE_LIMIT_MAX=300
CAPSULE_RATE_LIMIT_WINDOW_MS=60000
CAPSULE_CREATE_RATE_LIMIT_MAX=30
CAPSULE_LOG_LEVEL=info

# Capsules without expiry. Off by default: a relay that stores files forever
# needs an operator who decided to pay for that storage.
CAPSULE_ALLOW_PERSISTENT_CAPSULES=false
CAPSULE_MAX_PERSISTENT_BYTES=1073741824
# One sender's share of that storage, so the first arrival cannot take it all.
CAPSULE_MAX_PERSISTENT_BYTES_PER_SENDER=134217728

# Keeps client addresses out of logs and rate-limit state.
CAPSULE_IP_BLIND=true

# Joining the relay network. Set CAPSULE_PUBLIC_URL to the address other
# relays and clients can reach, and CAPSULE_PEERS to relays you already know.
# CAPSULE_PUBLIC_URL=https://relay.example.org
CAPSULE_RELAY_NAME=
CAPSULE_PEERS=
CAPSULE_MAX_PEERS=200
CAPSULE_PEER_SYNC_INTERVAL_MS=300000
# Work an announcing relay must do, in leading zero bits of its digest. Raising
# this makes flooding the directory with invented relays proportionally costly;
# 0 accepts announcements without any work.
CAPSULE_ANNOUNCE_POW_BITS=18
# Relays kept per apparent operator, so one domain cannot fill the directory.
CAPSULE_MAX_PEERS_PER_OPERATOR=4
# Allow peers on loopback/private addresses. Leave this off on a public relay:
# it is the check that stops an announced address from pointing back into your
# own network.
CAPSULE_ALLOW_PRIVATE_PEERS=false
VITE_RELAY_URL=http://localhost:8787
VITE_PUBLIC_APP_URL=http://localhost:5173/
