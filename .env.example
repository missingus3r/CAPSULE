CAPSULE_HOST=127.0.0.1
CAPSULE_PORT=8787
CAPSULE_STORAGE_DIR=./data
# Browser origins allowed to talk to this relay. localhost and 127.0.0.1 are
# the same machine but different origins to a browser, and a page opened at
# the wrong one fails with what looks like a network error. A relay with
# CAPSULE_PUBLIC_URL set defaults to * instead: it has to answer browsers it
# has never heard of.
CAPSULE_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CAPSULE_MAX_CAPSULE_BYTES=104857600
CAPSULE_MAX_CHUNK_BYTES=1048600
CAPSULE_MAX_MANIFEST_BYTES=262144
CAPSULE_MAX_CHUNK_COUNT=10000
CAPSULE_DEFAULT_TTL_SECONDS=86400
CAPSULE_MAX_TTL_SECONDS=604800
CAPSULE_CLEANUP_INTERVAL_MS=60000
CAPSULE_RATE_LIMIT_MAX=300
CAPSULE_RATE_LIMIT_WINDOW_MS=60000
CAPSULE_CREATE_RATE_LIMIT_MAX=30
CAPSULE_LOG_LEVEL=info

# Capsules without expiry. On by default, and bounded: the cap below is what a
# relay nobody configured is agreeing to give up, not an open-ended promise.
# Set this to false to refuse them, and the "no expiry" option then shows as
# unavailable in the apps rather than failing at upload.
CAPSULE_ALLOW_PERSISTENT_CAPSULES=true
CAPSULE_MAX_PERSISTENT_BYTES=1073741824
# One sender's share of that storage, so the first arrival cannot take it all.
CAPSULE_MAX_PERSISTENT_BYTES_PER_SENDER=134217728

# Keeps client addresses out of logs and rate-limit state.
CAPSULE_IP_BLIND=true

# Joining the relay network. Set CAPSULE_PUBLIC_URL to the address other
# relays and clients can reach, and CAPSULE_PEERS to relays you already know.
# CAPSULE_PUBLIC_URL=https://relay.example.org
CAPSULE_RELAY_NAME=
# A relay you already know, so yours is not alone. The genesis relay:
CAPSULE_PEERS=https://68.211.136.69.sslip.io
CAPSULE_MAX_PEERS=200
CAPSULE_PEER_SYNC_INTERVAL_MS=300000
# Work an announcing relay must do, in leading zero bits of its digest. Raising
# this makes flooding the directory with invented relays proportionally costly;
# 0 accepts announcements without any work.
CAPSULE_ANNOUNCE_POW_BITS=18
# Relays kept per apparent operator, so one domain cannot fill the directory.
CAPSULE_MAX_PEERS_PER_OPERATOR=4
# Allow peers on loopback/private addresses. Leave this off on a public relay:
# it is the check that stops an announced address from pointing back into your
# own network.
CAPSULE_ALLOW_PRIVATE_PEERS=false
# `.capsule` sites. A relay stores and gossips signed site records; it cannot
# read a site or forge one, and it can refuse to take part entirely.
# Bridge mode. An unlisted relay for people whose access to the public ones is
# blocked: it announces nothing and answers everyone without the bridge line
# like an ordinary web server. Use HTTPS, or it hides nothing.
CAPSULE_BRIDGE=false
# CAPSULE_BRIDGE_HOST=bridge.example.org
# CAPSULE_BRIDGE_DECOY=/srv/www/index.html
# CAPSULE_BRIDGE_KEY=

# Announce this relay on the local network so a client with no internet and no
# DNS can find it. Off by default: a beacon tells the whole network CAPSULE is
# running here.
CAPSULE_LAN=false

CAPSULE_SITES_ENABLED=true
CAPSULE_MAX_SITES=5000
CAPSULE_SITE_GOSSIP_LIMIT=200

# The relay the web app stores capsules on. Defaults to the genesis relay when
# unset, which is fine to try and worth replacing with your own: it sees the
# address, the timing and the size of everything that goes through it.
VITE_RELAY_URL=https://68.211.136.69.sslip.io
VITE_PUBLIC_APP_URL=http://localhost:5173/
# A directory of sites that asked to be listed, built with `capsule index` and
# published under a name you hold. Set this to that name and the web app shows
# a link to it; leave it empty and no link appears, because an address that
# resolves to nothing is worse than none.
# Defaults to the index published by the genesis operator; set this to point
# the link at your own instead.
VITE_CAPSULE_INDEX=

# The mix network. Every relay is a mix node by default; a client routes its
# requests through several of them so the relay storing a capsule never sees
# who asked. Read docs/MIXNET.md before relying on it — a small network is not
# an anonymous one.
CAPSULE_MIX_ENABLED=true
# How often this node sends a packet to itself, so a link carrying nothing real
# still carries something. Zero turns cover traffic off.
CAPSULE_MIX_COVER_INTERVAL_MS=30000
# Ceiling for the delay a sender may ask this node to wait.
CAPSULE_MIX_MAX_DELAY_MS=300000
CAPSULE_MIX_MEAN_DELAY_MS=5000
CAPSULE_MIX_MAX_QUEUED=2048
CAPSULE_MIX_REPLAY_WINDOW_MS=3600000
CAPSULE_MIX_MAILBOX_DEPTH=256
CAPSULE_MIX_MAILBOX_TTL_MS=3600000
CAPSULE_MIX_SEND_TIMEOUT_MS=15000
CAPSULE_MIX_PATH_LENGTH=3
# Mix traffic is nothing like API traffic: relays forward for each other
# continuously and clients poll a mailbox while they wait.
CAPSULE_MIX_RATE_LIMIT_MAX=12000
