{
  "manifest_version": 3,
  "name": "CAPSULE",
  "version": "1.2.0",
  "description": "Opens .capsule sites: names that are their own key, pages no relay can read or forge.",
  "minimum_chrome_version": "137",
  "permissions": ["declarativeNetRequest", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "CAPSULE",
    "default_popup": "options.html"
  },
  "omnibox": {
    "keyword": "capsule"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'self' data:; child-src 'self' data:"
  },
  "icons": {
    "128": "icon128.png"
  }
}
